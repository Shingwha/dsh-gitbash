{
  "name": "dsh-gitbash",
  "version": "1.3.0",
  "description": "DeepSeek Harness plugin that replaces the PowerShell shell tool with Git Bash on Windows, with a configurable control panel.",
  "type": "module",
  "license": "MIT",
  "author": "Shingwha",
  "homepage": "https://github.com/Shingwha/dsh-gitbash#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Shingwha/dsh-gitbash.git"
  },
  "bugs": {
    "url": "https://github.com/Shingwha/dsh-gitbash/issues"
  },
  "keywords": [
    "dsh-plugin",
    "dsh-bundle",
    "deepseek",
    "deepseek-harness",
    "git-bash",
    "bash",
    "shell",
    "windows"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.3"
  },
  "exports": {
    ".": "./index.js",
    "./index.js": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.5"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-sandbox": "*",
    "@deepseek-ai/dsh-shell": "*",
    "@deepseek-ai/dsh-timeout": "*"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  }
}
